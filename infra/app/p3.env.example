# P3-00 local API/Worker must use the same reviewed configuration. Defaults remain off.
# Do not place credential values in this tracked template. Supply the key through a server Secret.
# Copy the same model settings to both private p1-api.env and p1-worker.env.
# Authorization-v4 migration/activation compares parsed values offline before service changes.
# Differences in DB/session credentials are excluded. P3 flags must match; only enabled
# channels compare their model secrets/policies/services. All-off leaves P2 Qwen/NER settings alone.
# public_synthetic enables the v2 assistant for currently authorized team Makers.
# It requires BOTH local Qwen and NER, and a matching reviewed policy dataClass.
# The operator sets the policy version, expiry, region, retention and budgets;
# input text cannot authorize a cloud route. Legacy synthetic still requires fixture grants.
P3_CLOUD_MODE=off
AZURE_OPENAI_ENDPOINT=https://tkd-resource.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-6-astra
# AZURE_OPENAI_API_KEY=<server-secret>
# P3_AZURE_API_KEY is a compatibility alias only; AZURE_OPENAI_API_KEY takes precedence.

# To run synthetic engineering validation, set P3_CLOUD_MODE=synthetic only after
# supplying a real reviewed policy and ALL limits. These examples are not bank approval.
# The migration/operator identity must separately insert an exact input-fingerprint
# grant into business.model_fixture_grants. Browser/API users cannot grant themselves one.
# Policy endpoint is the full /responses URL; model deployment and actualModels are separate.
# Any OpenAI-compatible HTTPS Responses endpoint is accepted (the AZURE_OPENAI_* names are kept).
# Azure OpenAI hosts receive the key as api-key; other services receive Authorization: Bearer.
# provider stays the fixed label azure-openai in every policy JSON.
# P3_EGRESS_POLICY_JSON={"id":"controlled_fixture","version":"fixture-1","approvalRef":"operator-approved-synthetic-fixture","dataClass":"synthetic","purpose":"draft_intake","provider":"azure-openai","deployment":"gpt-6-astra","actualModels":["<verified-response-model-id>"],"endpoint":"https://tkd-resource.openai.azure.com/openai/v1/responses","region":"<verified-Azure-resource-region>","retention":"<verified-account-retention-policy>","trainingUse":"disabled","subprocessors":["<verified-processing-parties>"],"expiresAt":"<approved-UTC-expiry>"}
# Bank mode requires a separately approved dataClass=bank policy. A Maker click is insufficient.
# All cost values are integer USD microdollars; prices are per one million tokens.
# No price/region/retention value is guessed from a model name.
# P3_MODEL_TIMEOUT_MS=30000
# P3_MODEL_MAX_INPUT_TOKENS=8000
# P3_MODEL_MAX_OUTPUT_TOKENS=1024
# P3_MODEL_REQUESTS_PER_MINUTE=6
# P3_MODEL_DAILY_BUDGET_MICROS=<approved-limit>
# P3_MODEL_CALL_BUDGET_MICROS=<approved-limit>
# P3_MODEL_INPUT_MICROS_PER_MILLION=<verified-price>
# P3_MODEL_OUTPUT_MICROS_PER_MILLION=<verified-price>
# P1_NER_BASE_URL=<approved-private-NER-endpoint>
# P1_NER_TOKEN=<server-secret>
# P1_NER_ALLOW_HTTP=false

# Local Qwen extraction is separately gated by a passing bounded-candidate evaluation.
# A connectivity/text probe does not authorize this flag or prove privacy filtering.
# Intake uses non-thinking + JSON object grammar, followed by strict local schema/source checks.
# This does not promote the shared P1 Qwen profile to a verified json_schema capability.
P3_LOCAL_INTAKE_ENABLED=false
P3_LOCAL_INTAKE_VALIDATED=false
# P1_QWEN_BASE_URL=<approved-private-vLLM-endpoint>
# P1_QWEN_MODEL=Qwen/Qwen3.5-9B
# P1_QWEN_TOKEN=<server-secret>
# P1_QWEN_ALLOW_HTTP=false
# P3_LOCAL_INTAKE_TIMEOUT_MS=60000
# P3_LOCAL_INTAKE_MAX_INPUT_TOKENS=6000
# P3_LOCAL_INTAKE_MAX_OUTPUT_TOKENS=1024
# P3_LOCAL_INTAKE_REQUESTS_PER_MINUTE=3
# P3_LOCAL_INTAKE_DAILY_BUDGET_MICROS=<approved-compute-budget>
# P3_LOCAL_INTAKE_CALL_BUDGET_MICROS=<approved-compute-budget>
# P3_LOCAL_INTAKE_INPUT_MICROS_PER_MILLION=<approved-compute-rate>
# P3_LOCAL_INTAKE_OUTPUT_MICROS_PER_MILLION=<approved-compute-rate>

# public_synthetic uses an independent, explicit budget for batched redaction and
# conversational form completion. It never inherits the legacy 3/min extraction
# limit. Copy all approved values to API and Worker before enabling.
# Short context blocks share a private call; large sources use bounded chunks.
# Optional capacity defaults remain 120000 source UTF-8 bytes and 64 private calls.
# Reviewed public_synthetic limits are at most 256000 bytes and 192 calls.
# The 256 source-block and 4096 private-entity limits remain unchanged.
# P3_ASSISTANT_MAX_SOURCE_BYTES=120000
# P3_ASSISTANT_MAX_PRIVACY_CALLS=64
# P3_ASSISTANT_LOCAL_TIMEOUT_MS=60000
# P3_ASSISTANT_LOCAL_MAX_INPUT_TOKENS=6000
# P3_ASSISTANT_LOCAL_MAX_OUTPUT_TOKENS=2048
# P3_ASSISTANT_LOCAL_REQUESTS_PER_MINUTE=60
# P3_ASSISTANT_LOCAL_DAILY_BUDGET_MICROS=<approved-compute-budget>
# P3_ASSISTANT_LOCAL_CALL_BUDGET_MICROS=<approved-compute-budget>
# P3_ASSISTANT_LOCAL_INPUT_MICROS_PER_MILLION=<approved-compute-rate>
# P3_ASSISTANT_LOCAL_OUTPUT_MICROS_PER_MILLION=<approved-compute-rate>
# P3_ASSISTANT_CLOUD_TIMEOUT_MS=120000
# P3_ASSISTANT_CLOUD_MAX_INPUT_TOKENS=16000
# MAX_INPUT_TOKENS caps the complete serialized UTF-8 body as a conservative
# token ceiling, not the source text alone or an actual tokenizer count.
# public_synthetic can explicitly allow up to 524288; other modes stay <=16000.
# Verify the deployed Azure context window and approve corresponding call/day
# budgets before expansion. Local Qwen stays <=6000 input and <=2048 output.
# P3_ASSISTANT_CLOUD_MAX_OUTPUT_TOKENS=4096
# P3_ASSISTANT_CLOUD_REQUESTS_PER_MINUTE=12
# P3_ASSISTANT_CLOUD_DAILY_BUDGET_MICROS=<approved-limit>
# P3_ASSISTANT_CLOUD_CALL_BUDGET_MICROS=<approved-limit>
# P3_ASSISTANT_CLOUD_INPUT_MICROS_PER_MILLION=<verified-price>
# P3_ASSISTANT_CLOUD_OUTPUT_MICROS_PER_MILLION=<verified-price>

# There is no automatic deletion/retention timer for draft/chat business records.
# intake_turns.expires_at is an execution deadline only. Discard freezes the draft.
# Failed/unknown calls never switch provider; unknown calls keep their budget reservation.

# P3-01 may be enabled independently. P3-02/04 review entry stays off until accepted.
# API and Worker must match these flags and the fixed OPA endpoint/version.
P3_REVIEW_CONFIG_ENABLED=false
P3_REVIEW_ENABLED=false
# P3_OPA_BASE_URL=<approved-internal-OPA-endpoint>
# P3_OPA_TOKEN=<server-secret>
P3_OPA_ALLOW_HTTP=false
# P3_OPA_BINARY is allowed only with P1_MODE=local for synthetic fixtures.
# Formal document processing always requires an explicitly bound published release.
# Document-purpose cloud extraction is independently disabled by default.
# Requires public_synthetic intake dependencies plus a document_extraction policy
# with explicit caseIds/documentIds. Never put a real policy or credential here.
P3_DOCUMENT_CLOUD_ENABLED=false
P3_DOCUMENT_CLOUD_MAX_OUTPUT_TOKENS=16384
# Optional after explicit migration 040; document extraction only, not the assistant.
# Actual-usage upper bound, NOT the Azure invoice. Unknown calls stay fully reserved.
# P3_DOCUMENT_CLOUD_PRICING_JSON={"version":"azure-astra-2026-09-03.v1","provider":"azure-openai","deployment":"gpt-6-astra","actualModels":["gpt-6-astra","gpt-6-astra-2026-09-03"],"sku":"GlobalStandard","basis":"usage_upper_bound"}
# Optional pair, only for new v2 document jobs; unset keeps existing output behavior.
# V1 and assistant requests keep their base settings. Daily budgets are unchanged.
# P3_DOCUMENT_CLOUD_V2_REASONING_EFFORT=low
# P3_DOCUMENT_CLOUD_V2_MAX_OUTPUT_TOKENS=32768
# Source-bound NER is opt-in for a new extraction-v2 input snapshot only.
# The private NER service must support verified native spans; no silent fallback.
P3_DOCUMENT_NER_SOURCE_SPANS_ENABLED=false
P3_DOCUMENT_EGRESS_POLICY_JSON=

# Private signature vision: opt in only after GPU capacity/text and fixed-corpus quality gates.
# API/Worker must match. No cloud image fallback; only the listed PDFs are admitted.
P3_SIGNATURE_VISION_ENABLED=false
# P3_SIGNATURE_VISION_MODEL_REVISION=c202236235762e1c871ad0ccb60c8ee5ba337b9a
# P3_SIGNATURE_VISION_CASE_IDS=<approved-case-uuid>
# P3_SIGNATURE_VISION_DOCUMENT_IDS=<comma-separated-approved-document-uuids>

# Company name lookup is a separate, manually triggered GLEIF purpose.
# Parsing never calls GLEIF. API/Worker flag and policy must match.
# Fixed endpoint https://api.gleif.org; no model credentials or document text.
# Policy keys: id, version, approvalRef, purpose=company_lookup, provider=GLEIF,
# origin=https://api.gleif.org, dataClass=public_synthetic|bank, caseIds, expiresAt,
# requestsPerMinute (1..60, default10), requestsPerDay (1..10000, default200).
# Positive cache24h / negative cache1h, shortened by policy expiry; no stale adoption.
P4_COMPANY_LOOKUP_ENABLED=false
P4_COMPANY_LOOKUP_POLICY_JSON=

# Case assistant chat (Azure, after private NER redaction). Default off; API/Worker must match.
# Config JSON keys: policy{id,version,approvalRef,dataClass=public_synthetic,purpose=case_assist,
# provider=azure-openai,deployment,actualModels,endpoint,region,retention,trainingUse=disabled,
# subprocessors,expiresAt,budgetId,totalBudgetMicros,caseScope{kind=listed,caseIds}|{kind=synthetic_configuration}},
# model,endpoint,maxInputTokens,maxOutputTokens,timeoutMs,requestsPerMinute,dailyBudgetMicros,callBudgetMicros,
# inputMicrosPerMillion,outputMicrosPerMillion,ner{baseUrl,allowHttp,timeoutMs},maxSourceBytes,maxPrivacyCalls.
# Tokens are separate secrets. Rules confirmed in chat still go through the review command.
P4_CASE_ASSISTANT_ENABLED=false
P4_CASE_ASSISTANT_CONFIG_JSON=
P4_CASE_ASSISTANT_TOKEN=
P4_CASE_ASSISTANT_NER_TOKEN=

# Explicit new v2 document parses only. Private bounded crop OCR, max 2/page and 6/document.
# Requires enabled document reader, private OCR and approved document-cloud v2 configuration.
P4_DOCUMENT_REGION_OCR_ENABLED=false

# Independent BCO case approvals for public/synthetic PDFs only. Requires migration 041 and compatible API/Worker.
P3_DOCUMENT_CASE_AUTHORIZATION_ENABLED=false

# Independent cloud_review authorization and budget are required. Disabled on this release.
P3_FORMAL_REVIEW_ENABLED=false

# Reuse the existing public/synthetic PDF policy after a Maker scope declaration.
# Does not authorize real customer data or alter provider, purpose, expiry, privacy or budgets.
P3_DOCUMENT_POLICY_REUSE_ENABLED=false

# Explicit temporary hosted replacement; see docs/temporary-bailian-model-20261111.md.
# P1_QWEN_PROVIDER=bailian
# P1_QWEN_HOSTED_POLICY_JSON=<approved-original-policy-with-exact-endpoint-model-and-expiry>
# Never put the API key in this example.

# Subject confirmation: when true, files are attached to guarantor subjects only after the reviewer confirms
# the round's subjects on the information-check page. API/Worker must match. Default off.
# P4_SUBJECT_CONFIRMATION_ENABLED=false
