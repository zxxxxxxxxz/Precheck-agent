# Merge these explicit rollout flags into BOTH private API and Worker env files.
# This template never changes database, session or OSS credentials.
P2_DOCUMENT_ENABLED=false
P2_AUTOMATIC_PREPARSE=false
P2_READER_ENABLED=false
P2_DIRECTORY_ENABLED=false
P2_SEARCH_ENABLED=false
P2_COMPARISON_ENABLED=false
P2_MCP_ENABLED=false
P2_DOCX_ENABLED=false
P2_DOCX_PREVIEW_ENABLED=false
P2_MOCK_VALIDATION_ENABLED=false
P2_FIELD_FILTER_ENABLED=false

# DOCX originals: 25 MiB, pages belong to the pinned derived PDF (max 500).
# Enable preview only after the exact Linux runtime/fonts and sandbox probe pass.
# P2_DOCX_RUNTIME_ROOT=/opt/p2-docx
# P2_DOCX_RUNTIME_MANIFEST_SHA256=<verified-runtime-manifest-sha256>
# P2_DOCX_BWRAP_PATH=/opt/p2-docx/rootfs/usr/bin/bwrap
# P2_DOCX_TEMP_ROOT=/tmp
# Mock creation is an explicit operator CLI action, never a public write route.
# Original bytes remain unchanged; OCR receives only the overlaid PNG.
# P2_MOCK_FONT_PATH=/opt/p2-mock-fonts/NotoSansCJKsc-Regular.otf
# P2_MOCK_FONT_SHA256=2c76254f6fc379fddfce0a7e84fb5385bb135d3e399294f6eeb6680d0365b74b
# P2_MOCK_FONT_FAMILY=NotoSansCJKSCMock

# P2-02: enable DOCUMENT, AUTOMATIC_PREPARSE and READER after acceptance.
# P2-03: enable DIRECTORY after acceptance.
# P2-04: enable SEARCH and COMPARISON after measured retrieval acceptance.
# READER may remain true when DOCUMENT is paused, preserving historical access.
# PDF capacity is 50 MiB / 500 pages in loadConfig/loadP2Config.
# DOCX conversion keeps its 120-second timeout, 512 MiB temporary volume and
# 256 MiB stored-artifact budget; increasing the page ceiling does not change them.

# Configure existing inference endpoints privately in both process env files.
# P1_OCR_BASE_URL=https://approved-internal-ocr.example
# P1_OCR_TOKEN=<private-token>
# P1_NER_BASE_URL=https://approved-internal-ner.example
# P1_NER_TOKEN=<private-token>
# Private semantic filtering requires DOCUMENT + READER and the same model
# settings in both API and Worker. Existing parses require an extract command.
# P1_QWEN_BASE_URL=https://approved-private-qwen.example/v1
# P1_QWEN_TOKEN=<private-token>
# P1_QWEN_MODEL=Qwen/Qwen3.5-9B
# P1_QWEN_ALLOW_HTTP=false
# This flag does not enable any P3/cloud channel. Failures never adopt raw candidates.
# Set each *_ALLOW_HTTP=true only for an explicitly approved internal HTTP route.

# Internal MCP requires ES256 public key, issuer and audience as well as a
# database delegation. Human actor/scopes cannot be supplied by a model.
# P2_MCP_PUBLIC_KEY=<trusted-SPKI-public-key-with-escaped-newlines>
# P2_MCP_ISSUER=<trusted-issuer>
# P2_MCP_AUDIENCE=<document-tools-audience>
