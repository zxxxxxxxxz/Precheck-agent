[Unit]
Description=HSBC Compose infrastructure
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/data/hsbc

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/data/hsbc/deploy
ExecStartPre=/usr/bin/mountpoint -q /data
ExecStart=/data/hsbc/scripts/compose.sh up -d
ExecStop=/data/hsbc/scripts/compose.sh stop
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

