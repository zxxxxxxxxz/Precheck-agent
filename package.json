{
  "name": "crossborder-finance-review-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "env:init": "node infra/dev/p0-native.mjs init",
    "env:start": "node infra/dev/p0-native.mjs start",
    "env:stop": "node infra/dev/p0-native.mjs stop",
    "env:status": "node infra/dev/p0-native.mjs status",
    "env:doctor": "node infra/dev/p0-native.mjs doctor",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed-p0.ts",
    "probe:ocr": "node --import tsx packages/testing/src/document/probe-ocr.ts",
    "probe:ocr-regions": "node --import tsx packages/testing/src/document/probe-ocr-regions.ts",
    "dev:api": "node --import tsx apps/api/src/experiments/p0.ts",
    "dev:worker": "node --import tsx apps/worker/src/experiments/p0.ts",
    "dev:web": "vite apps/web --host 127.0.0.1 --port 5173 --strictPort",
    "dev:preview": "node scripts/dev-preview.mjs",
    "dev:preview:check": "node scripts/dev-preview.mjs --check",
    "env:p1:init": "node infra/dev/p1-native.mjs init",
    "env:p1:start": "node infra/dev/p1-native.mjs start",
    "env:p1:doctor": "node infra/dev/p1-native.mjs doctor",
    "db:p1:migrate": "node --env-file=.env.p1.local --import tsx scripts/p1-migrate.ts",
    "db:p1:bootstrap": "node --env-file=.env.p1.local --import tsx scripts/p1-bootstrap.ts",
    "dev:p1:api": "node --env-file=.env.p1.local --import tsx apps/api/src/application.ts",
    "dev:p1:worker": "node --env-file=.env.p1.local --import tsx apps/worker/src/application.ts",
    "dev:application:api": "node --env-file=.env.p1.local --import tsx apps/api/src/application.ts",
    "dev:application:worker": "node --env-file=.env.p1.local --import tsx apps/worker/src/application.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "dev:team:api": "node --env-file=.env.p1.local --env-file=infra/dev/team-preview.env --import tsx apps/api/src/application.ts",
    "dev:team:worker": "node --env-file=.env.p1.local --env-file=infra/dev/team-preview.env --import tsx apps/worker/src/application.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@alicloud/credentials": "2.4.7",
    "@ant-design/x": "2.9.0",
    "@ant-design/x-sdk": "2.9.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/session": "11.1.4",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.5.0",
    "@langchain/langgraph-checkpoint": "1.2.0",
    "@langchain/langgraph-checkpoint-postgres": "1.1.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/fastify": "2.0.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@napi-rs/canvas": "1.0.11",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/sequelize": "12.0.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@tanstack/react-query": "5.104.2",
    "ali-oss": "6.23.0",
    "antd": "6.6.6",
    "argon2": "0.45.1",
    "bullmq": "6.3.13",
    "connect-pg-simple": "10.0.0",
    "express-session": "1.19.0",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "saxes": "6.0.0",
    "sequelize": "6.37.8",
    "sequelize-typescript": "2.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.3",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express-session": "1.19.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/validator": "13.15.10",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "@hsbc/contracts": "workspace:*",
    "@hsbc/server": "workspace:*",
    "@hsbc/workflows": "workspace:*",
    "@hsbc/testing": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "@nestjs/core"
    ]
  }
}
